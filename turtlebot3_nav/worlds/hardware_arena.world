<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hardware_arena">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 경기장 바닥 표시용: visual만 있음. collision 없음. -->
    <model name="arena_floor_visual">
      <static>true</static>
      <pose>3.0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>7.0 3.0 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 좌측 벽 -->
    <model name="left_wall">
      <static>true</static>
      <pose>3.0 1.55 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>7.0 0.08 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>7.0 0.08 0.50</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 우측 벽 -->
    <model name="right_wall">
      <static>true</static>
      <pose>3.0 -1.55 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>7.0 0.08 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>7.0 0.08 0.50</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 시작선 뒤쪽 벽 -->
    <model name="start_wall">
      <static>true</static>
      <pose>-0.5 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 3.0 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 3.0 0.50</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 목표선 뒤쪽 벽: 목표점 5.5m보다 뒤에 배치 -->
    <model name="finish_wall">
      <static>true</static>
      <pose>6.6 0 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 3.0 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 3.0 0.50</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 목표 지점 표시용: visual만 있음. 라이다/충돌에는 안 잡힘. -->
    <model name="goal_marker_ground">
      <static>true</static>
      <pose>5.5 0 0.015 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.03</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>
            <diffuse>0.0 1.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>