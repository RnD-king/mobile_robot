<?xml version="1.0"?>
<sdf version="1.6">
  <model name="l_obstacle_50cm">
    <static>true</static>
    <!--
      Model origin: inner corner on the floor.
      At yaw=0:
        - one wall extends from x=0.0 to x=0.50, y=0.0 to y=0.03
        - one wall extends from x=0.0 to x=0.03, y=0.0 to y=0.50
      Spawn z should normally be 0.0.
    -->

    <link name="x_wall_link">
      <pose>0.25 0.015 0.25 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.50 0.03 0.50</size>
          </box>
        </geometry>
        <material>
          <ambient>0.90 0.25 0.05 1.0</ambient>
          <diffuse>0.90 0.25 0.05 1.0</diffuse>
          <specular>0.10 0.10 0.10 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.50 0.03 0.50</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.0125</ixx>
          <iyy>0.0250</iyy>
          <izz>0.0125</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <link name="y_wall_link">
      <pose>0.015 0.25 0.25 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.03 0.50 0.50</size>
          </box>
        </geometry>
        <material>
          <ambient>0.90 0.25 0.05 1.0</ambient>
          <diffuse>0.90 0.25 0.05 1.0</diffuse>
          <specular>0.10 0.10 0.10 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.03 0.50 0.50</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.0250</ixx>
          <iyy>0.0125</iyy>
          <izz>0.0125</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
